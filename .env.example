# ==============================================================================
# Rudra (DRISHTI) - Smart Tourist Safety & Emergency Response Platform
# Environment Configuration
# ==============================================================================

# Core Application Settings
APP_NAME=Rudra
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=true
DEMO_MODE=true
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# In demo mode, SQLite is used by default. In production, configure PostgreSQL/Supabase:
DATABASE_URL=sqlite:///./rudra.db
# Supabase PostgreSQL (use the connection string from Project Settings > Database)
# DATABASE_URL=postgresql+psycopg2://postgres:password@db.project-ref.supabase.co:5432/postgres
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
AUTH_PROVIDER=backend

# CORS Allowed Origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://localhost:8000

# Blockchain Ledger Settings
# In DEMO_MODE=true, Rudra uses a local SHA-256 Merkle tamper-evident ledger.
# In PRODUCTION, provide EVM JSON-RPC provider credentials:
BLOCKCHAIN_MODE=simulated_merkle
BLOCKCHAIN_RPC_URL=https://rpc.sepolia.org
BLOCKCHAIN_PRIVATE_KEY=
BLOCKCHAIN_CONTRACT_ADDRESS=

# External Integrations (Optional in DEMO_MODE)
WEATHER_API_KEY=
WEATHER_PROVIDER=openweather
SMS_PROVIDER=mock
SMS_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# AI Intelligence Service
LLM_PROVIDER=gemini
GEMINI_API_KEY=

# Payment / UPI Configuration
PAYMENT_PROVIDER=upi_simulator
MERCHANT_VPA=drishti.safety@gov.in
MERCHANT_NAME=Nilgiris District Tourism & Safety Administration
